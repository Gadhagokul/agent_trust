APP_NAME=Agent Trust Score API
APP_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=your_username
DB_PASSWORD=your_password

REDIS_URL=redis://127.0.0.1:6379/0
# Server-to-server service token, shared with Laravel. Generate once:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# and put the SAME value in the Laravel .env. Laravel sends it as
# "Authorization: Bearer <token>" on every request to this API.
LARAVEL_SERVICE_TOKEN=
IDENTITY_MODEL_TYPE=App\Models\User
CORS_ORIGINS=http://localhost:3000
